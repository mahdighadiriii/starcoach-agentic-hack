# Copy to .env and fill in. Never commit .env.
TRADING_MODE=shadow
# Live also needs an operator arm record (`python -m wtrader arm-live ...`); this flag alone never enables it.
LIVE_ENABLED=false
# Competition trade-credit sub-account: its own API key + sub-account client id (developers.wallex.ir, spot-intro)
WALLEX_API_KEY=
WALLEX_SUB_ACCOUNT_CLIENT_ID=
# No ID means the key's default wallet, not independently verified main-account ownership.
# Read-only discovery never auto-selects a returned account. Package access may require additional permissions.
WALLEX_API_BASE_URL=https://api.wallex.ir
# Network path to Wallex (api.wallex.ir only answers Iranian egress; a full-tunnel VPN stalls TLS).
# Optional: send Wallex REST + WebSocket out of this physical interface instead of the VPN (macOS: en0).
# TLS verification is unchanged. Alternative: exclude api.wallex.ir from the VPN (split tunnel).
WALLEX_BIND_INTERFACE=
# Optional: HTTP(S) proxy with an Iranian egress, used for Wallex only
WALLEX_HTTP_PROXY=
# Organizer-confirmed markets for the competition account (live is blocked while empty)
WALLEX_ALLOWED_MARKETS=
# Organizer-confirmed clock, ISO-8601 with offset, e.g. 2026-10-25T09:00:00+03:30
TRADE_START=
TRADE_END=
# BoxAPI uses the OpenAI-compatible SDK. No OPENAI_API_KEY is required.
LLM_PROVIDER=boxapi
BOXAPI_API_KEY=
BOXAPI_BASE_URL=https://ai.boxapi.ir/ai/v1
LLM_MODEL_ID=gpt-5.4-mini
# AI_MODE=baseline (or LLM_PROVIDER=baseline) makes no LLM requests.
AI_MODE=ai
# Optional estimates, USD per million tokens. Blank means cost unknown, not free.
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=
LLM_CACHED_INPUT_USD_PER_MILLION=
# Optional legacy provider: install requirements-anthropic.txt, set LLM_PROVIDER=anthropic
# and set LLM_MODEL_ID explicitly to the supported Anthropic model.
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
# Optional: JSON webhook for critical alerts (receives {"text": ...})
ALERT_WEBHOOK_URL=
# Dashboard bind address (default 127.0.0.1). Never expose it publicly.
MONITOR_HOST=127.0.0.1
