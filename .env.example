# Copy to .env and fill in. Never commit .env.

# --- LLM (BoxAPI) ---
# Base URL + hackathon models: https://boxapi.ir/starcoach (credit is $3 per key)
LLM_BASE_URL=https://ai.boxapi.ir/ai/v1
LLM_API_KEY=
LLM_MODEL=gpt-5-mini

# --- Wallex ---
WALLEX_BASE_URL=https://api.wallex.ir
WALLEX_API_KEY=

# --- Trading / safety ---
# DRY_RUN=true means NO real orders are ever sent. Flip only when the team agrees.
DRY_RUN=true
SYMBOLS=BTCTMN,ETHTMN,USDTTMN
QUOTE_ASSET=TMN
MAX_ORDER_QUOTE=500000      # max value of a single order, in toman (account is 5M TMN)
MAX_POSITION_PCT=0.25       # max share of portfolio in one asset
MAX_DAILY_LOSS_PCT=0.05     # kill switch: stop trading after this daily drawdown
MIN_CONFIDENCE=0.6          # LLM decisions below this are downgraded to HOLD
LOOP_INTERVAL_SEC=300

# --- End of trading window ---
# Profit only counts in TMN. From FLATTEN_MINUTES_BEFORE until WINDOW_END the bot
# stops buying, cancels open orders and sells every coin back to TMN.
# Leave WINDOW_END empty until the official end time is announced.
WINDOW_END=                 # e.g. 2026-10-26T23:59:00+03:30
FLATTEN_MINUTES_BEFORE=60
FLATTEN_SLIPPAGE_PCT=0.005
